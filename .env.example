# ──────────────────────────────────────────────────────────────────
# aprosop.ru — переменные окружения.
# На сервере: скопируйте в .env рядом с docker-compose.yml и заполните.
# .env НЕ коммитится в git и НЕ трогается автодеплоем.
# Строки, закомментированные решёткой, необязательны — тогда действует
# значение по умолчанию (указано в комментарии).
# ──────────────────────────────────────────────────────────────────

# ─── Django ──────────────────────────────────────────────────────
# Длинная случайная строка (50+ символов). Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-min-50-chars
# В production всегда False (по умолчанию False)
DEBUG=False
# Домены, с которых Django принимает запросы (через запятую).
# Первый в списке используется healthcheck'ом контейнера api.
ALLOWED_HOSTS=aprosop.ru,www.aprosop.ru,localhost,127.0.0.1
# Откуда фронтенд может ходить в API
CORS_ALLOWED_ORIGINS=https://aprosop.ru,https://www.aprosop.ru
# По умолчанию: http(s)://aprosop.ru, http(s)://www.aprosop.ru, localhost
#CSRF_TRUSTED_ORIGINS=https://aprosop.ru,https://www.aprosop.ru

# ─── Авторизация / анонимность ───────────────────────────────────
# Ключ подписи JWT. По умолчанию = SECRET_KEY.
# Смена значения разлогинит всех пользователей.
#JWT_SECRET_KEY=your-jwt-secret-key
# Время жизни токенов (если поддерживается бэкендом)
#JWT_ACCESS_MINUTES=120
#JWT_REFRESH_DAYS=7
# Соль для хэширования email. !!! НИКОГДА не меняйте на работающем сайте —
# все существующие пользователи потеряют доступ к аккаунтам.
# Текущее production-значение (оно же значение по умолчанию):
EMAIL_HASH_SALT=ANON_PSY_EMAIL_SALT_v1
# Администратор, создаваемый командой create_admin при старте
ADMIN_LOGIN=root
ADMIN_PASSWORD=change-me-strong-password
# Лимит попыток входа/регистрации (по умолчанию 20/min)
#AUTH_THROTTLE_RATE=20/min
# Часовой пояс расписания психологов (по умолчанию Europe/Moscow)
#SCHEDULE_TIME_ZONE=Europe/Moscow

# ─── База данных (PostgreSQL в контейнере db) ────────────────────
DB_NAME=anonpsy
DB_USER=postgres
DB_PASSWORD=your-db-password
# DB_HOST / DB_PORT / REDIS_URL задаются в docker-compose.yml (db:5432, redis:6379)
# и нужны только для запуска без Docker:
#DB_HOST=localhost
#DB_PORT=5432
#REDIS_URL=redis://localhost:6379/0

# ─── Платежи: анонимный баланс и ЮKassa (подробно: docs/PAYMENTS.md) ───
# Пока ключи не заданы (или остались заглушки ниже) — работает ТЕСТОВАЯ касса:
# пополнение проходит на нашей тестовой странице, деньги не списываются.
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret
# Адрес сайта для возврата после оплаты (по умолчанию https://aprosop.ru)
#BILLING_PUBLIC_URL=https://aprosop.ru
# Тестовая касса: по умолчанию включена, если нет ключей ЮKassa или DEBUG=True.
# После подключения ЮKassa поставьте false.
#BILLING_MOCK_ENABLED=false
# redirect — страница ЮKassa (по умолчанию), embedded — виджет на нашей странице
#BILLING_YOOKASSA_CONFIRMATION=redirect
# Проверять IP вебхуков ЮKassa (по умолчанию True)
#BILLING_WEBHOOK_IP_CHECK=True
# Выплаты специалистам через ЮKassa (отдельный шлюз «Выплаты»). Пусто — выплаты вручную.
#YOOKASSA_PAYOUT_AGENT_ID=
#YOOKASSA_PAYOUT_SECRET_KEY=
# Чеки 54-ФЗ через «Чеки от ЮKassa» (см. docs/PAYMENTS.md — согласуйте с бухгалтером)
#BILLING_RECEIPTS_ENABLED=False
#BILLING_RECEIPT_REQUIRED=False
#BILLING_RECEIPT_VAT_CODE=1
#BILLING_RECEIPT_TAX_SYSTEM_CODE=0
#BILLING_RECEIPT_PAYMENT_MODE=full_prepayment
#BILLING_RECEIPT_PAYMENT_SUBJECT=service
# Ключ шифрования реквизитов специалистов (Fernet). По умолчанию выводится из SECRET_KEY.
#BILLING_ENCRYPTION_KEY=
# Правила (значения по умолчанию)
#BILLING_TOPUP_MIN_RUB=100
#BILLING_TOPUP_MAX_RUB=50000
#BILLING_TOPUP_PRESETS_RUB=1000,3000,5000,10000
#BILLING_MAX_BALANCE_RUB=150000
#BILLING_FREE_CANCEL_HOURS=24
#BILLING_LATE_CANCEL_PENALTY_PERCENT=50
#BILLING_EARNINGS_HOLD_HOURS=24
#BILLING_UNPAID_TTL_MINUTES=30
#BILLING_SETTLE_GRACE_MINUTES=60
#BILLING_PAYOUT_MIN_RUB=500
# Устарело (старые платежи «на сессию»): YOOKASSA_RETURN_URL, YOOKASSA_WEBHOOK_SECRET
#YOOKASSA_RETURN_URL=https://aprosop.ru/app/sessions

# Комиссия платформы, % (по умолчанию 20)
PLATFORM_FEE_PERCENT=20.0

# ─── TURN-сервер (coturn, видеозвонки) ───────────────────────────
# По умолчанию aprosop / aprosopsecretturn. Если меняете — меняется и
# в coturn, и во фронтенде (NEXT_PUBLIC_TURN_* берут эти же значения).
#TURN_USER=aprosop
#TURN_PASSWORD=aprosopsecretturn

# ─── Чаты ────────────────────────────────────────────────────────
# Ключ шифрования сообщений и файлов (Fernet). Сгенерировать:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если не задан — выводится из SECRET_KEY (тогда смена SECRET_KEY сделает
# старые сообщения нечитаемыми). Ротация: "новый,старый" через запятую.
# !!! Не теряйте и не меняйте без ротации — иначе история чатов пропадёт.
#CHAT_ENCRYPTION_KEY=
# Разрешить клиенту писать специалисту без записи (по умолчанию False)
#CHAT_ALLOW_WITHOUT_BOOKING=False
# Максимальный размер файла в чате, МБ (по умолчанию 20; nginx пропускает до 25)
#CHAT_MAX_FILE_MB=20
# Лимит отправки сообщений на пользователя (по умолчанию 40/min)
#CHAT_SEND_RATE=40/min

# ─── ИИ-помощник «Тиша» (Anthropic Claude API) ───────────────────
# Без ключа чат с Тишей показывает «скоро появится».
#ANTHROPIC_API_KEY=
# Модель (по умолчанию claude-sonnet-5) и глубина рассуждений low|medium|high
#AI_MODEL=claude-sonnet-5
#AI_EFFORT=medium
# Сообщений Тише на пользователя в сутки (по умолчанию 40)
#AI_DAILY_LIMIT=40

# ─── Next.js (вшиваются в фронтенд при СБОРКЕ) ───────────────────
# После изменения нужен деплой (пересборка web), перезапуска мало.
NEXT_PUBLIC_API_URL=https://aprosop.ru/api/v1
NEXT_PUBLIC_WS_URL=wss://aprosop.ru
# По умолчанию = TURN_USER / TURN_PASSWORD
#NEXT_PUBLIC_TURN_USER=aprosop
#NEXT_PUBLIC_TURN_PASSWORD=aprosopsecretturn
