{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-lead/types/**/*.ts",
    ".next-6/types/**/*.ts",
    ".next-7/types/**/*.ts",
    ".next-8/types/**/*.ts",
    ".next-10/types/**/*.ts",
    ".next-9/types/**/*.ts",
    ".next-11/types/**/*.ts",
    ".next-13/types/**/*.ts",
    ".next-16/types/**/*.ts",
    ".next-14/types/**/*.ts",
    ".next-15/types/**/*.ts",
    ".next-18/types/**/*.ts",
    ".next-17/types/**/*.ts",
    ".next-19/types/**/*.ts",
    ".next-21/types/**/*.ts",
    ".next-20/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
